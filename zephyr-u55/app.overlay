/* The Ethos-U cannot DMA to the Cortex-M55 DTCM selected by the board DTS.
 * Combine SRAM0 and SRAM1 into one NPU-accessible application RAM region.
 */
/delete-node/ &sram0;
/delete-node/ &sram1;

&soc {
	ethosu0: ethosu55@400e1000 {
		compatible = "arm,ethos-u";
		reg = <0x400e1000 0x1000>;
		interrupts = <55 0>;
		interrupt-parent = <&nvic>;
		secure-enable;
		privilege-enable;
		status = "okay";
	};

	sram0: sram@2000000 {
		compatible = "zephyr,memory-region", "mmio-sram";
		reg = <0x2000000 DT_SIZE_M(8)>;
		zephyr,memory-region = "SRAM0";
	};
};

/ {
	chosen {
		zephyr,sram = &sram0;
	};
};
